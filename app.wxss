/* 视觉：参考山寺（sansatemple.com）的深色质感——深橄榄底、半透明深色面板、奶油色文字、金色选中、橄榄实心按钮 */
page {
  --bg: #24251f;
  --bg-2: #1b1c17;
  --panel: rgba(30, 31, 26, 0.82);
  --panel-solid: #2c2d26;
  --ink: #fffdf3;
  --ink-soft: rgba(255, 253, 243, 0.74);
  --stone: rgba(255, 253, 243, 0.52);
  --stone-light: rgba(255, 253, 243, 0.34);
  --line: rgba(255, 253, 243, 0.16);
  --field: rgba(255, 253, 243, 0.06);
  --pine: #747353;
  --pine-2: #626347;
  --paper: #fffdf3;
  --paper-2: #fffdf3;
  --gold: #e6d5ad;
  --gold-bg: rgba(180, 154, 96, 0.16);
  --amber: #e9b97d;
  --danger: #e59c88;
  --ok: #a8c48e;
  --shadow: 0 16rpx 56rpx rgba(0, 0, 0, 0.35);
  --serif: "Noto Serif CJK SC", "Noto Serif SC", "Songti SC", "STSong", serif;
  --sans: "PingFang SC", "Noto Sans CJK SC", "Apple SD Gothic Neo", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 30rpx;
  line-height: 1.6;
}
button { font-family: inherit; }
button::after { border: none; }

.page-bg {
  min-height: 100vh; box-sizing: border-box;
  background: radial-gradient(ellipse at 50% 0%, rgba(116, 115, 83, 0.28) 0%, rgba(36, 37, 31, 0) 60%), linear-gradient(180deg, #2a2b24 0%, #24251f 45%, #1b1c17 100%);
}
.serif { font-family: var(--serif); }

.btn {
  display: flex; align-items: center; justify-content: center; box-sizing: border-box;
  min-height: 96rpx; padding: 0 36rpx; margin: 0; border-radius: 16rpx;
  background: var(--pine); color: var(--paper); font-size: 30rpx; font-weight: 500; letter-spacing: 2rpx; line-height: 1.4;
}
.btn.hover { background: var(--pine-2); transform: scale(0.98); }
.btn.ghost { background: transparent; color: var(--ink); border: 2rpx solid var(--line); }
.btn.gold { background: var(--gold); color: #24251f; }
.btn.small { min-height: 84rpx; font-size: 28rpx; padding: 0 28rpx; }
.btn[disabled] { opacity: 0.5; background: var(--pine) !important; color: var(--paper) !important; }

.card {
  background: var(--panel); border: 2rpx solid var(--line);
  border-radius: 24rpx; padding: 44rpx 36rpx 44rpx; box-shadow: var(--shadow); box-sizing: border-box;
}
.card .h2 { font-family: var(--serif); font-size: 42rpx; margin: 0 0 16rpx; font-weight: 700; color: var(--ink); }
.card .sub { color: var(--ink-soft); font-size: 26rpx; line-height: 1.65; margin-bottom: 32rpx; }

.muted { color: var(--stone); font-size: 24rpx; }
.field { display: flex; flex-direction: column; margin-bottom: 28rpx; }
.field .label { font-size: 26rpx; color: var(--ink-soft); margin-bottom: 12rpx; }
.field .hint { font-size: 24rpx; color: var(--stone); margin-top: 8rpx; }
.input {
  min-height: 88rpx; box-sizing: border-box; padding: 0 24rpx; border-radius: 16rpx;
  background: var(--field); border: 2rpx solid var(--line); color: var(--ink); font-size: 30rpx;
}
.textarea {
  width: auto; min-height: 168rpx; padding: 20rpx 24rpx; border-radius: 16rpx;
  background: var(--field); border: 2rpx solid var(--line); color: var(--ink); font-size: 30rpx;
}
.ph { color: var(--stone-light); }
.err { color: var(--danger); font-size: 26rpx; margin: 8rpx 0 20rpx; }

.seg { display: flex; flex-wrap: wrap; gap: 12rpx; }
.seg-btn {
  min-height: 76rpx; padding: 0 24rpx; border-radius: 14rpx; border: 2rpx solid var(--line);
  background: var(--field); color: var(--ink-soft); font-size: 26rpx; display: flex; align-items: center;
}
.seg-btn.on { background: var(--gold-bg); color: var(--gold); border-color: rgba(230, 213, 173, 0.55); }

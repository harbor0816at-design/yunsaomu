.tomb-root { position: fixed; top: 0; right: 0; bottom: 0; left: 0; overflow: hidden; background: #b8c2b6; }
.scene { position: absolute; left: 0; top: 0; width: 100vw; height: 100vh; }
.ico { width: 44rpx; height: 44rpx; }

.hud-top { position: fixed; left: 20rpx; right: 200rpx; display: flex; align-items: center; gap: 16rpx; z-index: 5; }
.icon-btn { position: relative; width: 80rpx; height: 80rpx; border-radius: 50%; background: rgba(243, 239, 228, 0.9); color: var(--ink);
  display: flex; align-items: center; justify-content: center; font-size: 28rpx; box-shadow: 0 4rpx 20rpx rgba(40, 40, 32, 0.14); }
.icon-btn.on { background: var(--pine); color: var(--paper); }
.presence-chip { background: rgba(243, 239, 228, 0.92); border-radius: 999rpx; padding: 0 28rpx; height: 72rpx; font-size: 26rpx;
  display: flex; align-items: center; box-shadow: 0 4rpx 20rpx rgba(40, 40, 32, 0.14); white-space: nowrap; }
.live { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--stone-light); margin-left: 12rpx; }
.live.on { background: var(--ok); }

.tomb-title { position: fixed; left: 24rpx; z-index: 5; display: flex; flex-direction: column; gap: 8rpx; align-items: flex-start; }
.season-chip, .name-chip { font-size: 24rpx; background: rgba(243, 239, 228, 0.86); border-radius: 999rpx; padding: 6rpx 20rpx; color: var(--ink-soft); }
.name-chip.strong { font-family: var(--serif); font-size: 30rpx; color: var(--ink); font-weight: 700; padding: 8rpx 24rpx; }

.icon-col { position: fixed; right: 20rpx; z-index: 5; display: flex; flex-direction: column; gap: 16rpx; }
.dot-badge { position: absolute; right: -6rpx; top: -6rpx; min-width: 32rpx; height: 32rpx; border-radius: 16rpx; background: var(--danger); color: #fff;
  font-size: 20rpx; display: flex; align-items: center; justify-content: center; padding: 0 6rpx; }

.action-toast { position: fixed; left: 50%; transform: translateX(-50%); z-index: 25; background: rgba(36, 38, 34, 0.86); color: var(--paper-2);
  font-size: 26rpx; padding: 16rpx 32rpx; border-radius: 999rpx; box-shadow: var(--shadow); white-space: nowrap; pointer-events: none; opacity: 0; transition: opacity 0.3s; }
.action-toast.show { opacity: 1; }

.side-actions { position: fixed; right: 20rpx; bottom: calc(176rpx + env(safe-area-inset-bottom)); z-index: 5; display: flex; flex-direction: column; gap: 16rpx; }
.side-btn { width: 120rpx; min-height: 112rpx; border-radius: 28rpx; background: rgba(243, 239, 228, 0.92); color: var(--ink);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; font-size: 22rpx; box-shadow: 0 4rpx 20rpx rgba(40, 40, 32, 0.16); }

.wipe-panel { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(176rpx + env(safe-area-inset-bottom)); width: 470rpx; z-index: 6;
  background: rgba(243, 239, 228, 0.94); border-radius: 28rpx; padding: 20rpx 24rpx; box-shadow: var(--shadow); font-size: 24rpx; color: var(--ink-soft);
  opacity: 0; transition: opacity 0.3s; pointer-events: none; }
.wipe-panel.show { opacity: 1; }
.wipe-panel .row { display: flex; justify-content: space-between; align-items: center; }
.wipe-panel .strong { color: var(--ink); font-size: 28rpx; font-weight: 600; }
.wipe-panel .tip { margin-top: 8rpx; font-size: 22rpx; color: var(--stone); }
.wipe-bar { height: 12rpx; border-radius: 12rpx; background: #d5cfbf; margin-top: 12rpx; overflow: hidden; }
.wipe-bar .fill { height: 100%; background: var(--pine); transition: width 0.2s; }

.ritual-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 5; display: flex; justify-content: space-around;
  padding: 16rpx 12rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(42, 42, 38, 0), rgba(42, 42, 38, 0.45) 18%, rgba(36, 38, 34, 0.88)); }
.ritual-btn { flex: 1; min-height: 112rpx; color: var(--paper); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; font-size: 22rpx; letter-spacing: 0.04em; }
.ritual-btn .ri { width: 48rpx; height: 48rpx; }
.ritual-btn.active { color: var(--gold); }
.ritual-btn:active .ri { transform: scale(0.92); }

.loading { position: fixed; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28rpx;
  background: #c5cbb8; z-index: 12; font-family: var(--serif); color: var(--ink-soft); }
.ldot { width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--pine); animation: pulse 1.2s ease infinite; }
@keyframes pulse { 0%, 100% { opacity: 0.3; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1); } }
.overlay-center { position: fixed; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; background: #c5cbb8; z-index: 20; padding: 40rpx; }
.err-card { width: 100%; }

.mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(50, 54, 48, 0.3); z-index: 9; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; background: var(--paper-2); border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); box-shadow: 0 -16rpx 64rpx rgba(0, 0, 0, 0.2); max-height: 76vh; box-sizing: border-box;
  transform: translateY(105%); transition: transform 0.26s ease; }
.sheet.open { transform: translateY(0); }
.close-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.h3 { font-family: var(--serif); font-size: 36rpx; font-weight: 700; }
.close { color: var(--pine); font-size: 28rpx; padding: 8rpx 0 8rpx 24rpx; }
.sub { color: var(--ink-soft); font-size: 26rpx; line-height: 1.6; margin-bottom: 24rpx; }
.center { text-align: center; }
.pad { padding: 40rpx 0; }
.opt-title { font-size: 26rpx; color: var(--ink-soft); margin: 24rpx 0 12rpx; font-weight: 600; }
.flower-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20rpx; margin-bottom: 28rpx; }
.flower-opt { border: 4rpx solid var(--line); border-radius: 24rpx; background: var(--field); min-height: 176rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; font-size: 28rpx; }
.flower-opt:active { border-color: var(--pine); }
.f-dot { width: 88rpx; height: 88rpx; border-radius: 50%; }
.f-baiju { background: radial-gradient(circle, #e8cf6a 18%, #f7f4ea 22%, #f7f4ea 60%, #dcd6c4 100%); box-shadow: inset 0 0 0 2rpx #ddd6c4; }
.f-huangju { background: radial-gradient(circle, #b9822a 18%, #f2c94c 22%, #f2c94c 60%, #d9a92e 100%); }
.f-cuibai { background: radial-gradient(circle, #6f9a63 20%, #4f7d4f 60%, #3a6440 100%); }
.msg-list { max-height: 34vh; margin-bottom: 20rpx; }
.msg { padding: 20rpx 0; border-bottom: 2rpx solid #e0d9c8; }
.meta { font-size: 24rpx; color: var(--stone); margin-bottom: 4rpx; }
.body { font-size: 28rpx; line-height: 1.55; word-break: break-all; }
.badge { display: inline-block; font-size: 22rpx; padding: 2rpx 12rpx; border-radius: 12rpx; background: #e4ddc8; color: var(--ink-soft); margin-left: 12rpx; }
.badge.wait { background: #efe3c0; }
.badge.off { background: #e8d0cc; color: var(--danger); }
.mod { margin-top: 12rpx; display: flex; gap: 16rpx; }
.mbtn { font-size: 24rpx; padding: 8rpx 24rpx; border-radius: 20rpx; border: 2rpx solid #b9b4a4; background: var(--field); color: var(--ink); }
.mbtn.ok { background: var(--pine); color: var(--paper-2); border-color: var(--pine); }
.compose { margin-bottom: 20rpx; width: auto; }
.name-row { display: flex; gap: 16rpx; align-items: center; }
.grow { flex: 1; }
.btn.share { margin-bottom: 20rpx; }

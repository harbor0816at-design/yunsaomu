.tomb-root { position: fixed; top: 0; right: 0; bottom: 0; left: 0; overflow: hidden; background: #1b1c17; }
.scene { position: absolute; left: 0; top: 0; width: 100vw; height: 100vh; }
.vignette { position: absolute; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none;
  background: radial-gradient(ellipse at 50% 45%, rgba(0,0,0,0) 55%, rgba(10,10,8,0.42) 100%); }
.ico { width: 40rpx; height: 40rpx; }

.hud-top { position: fixed; left: 20rpx; right: 200rpx; display: flex; align-items: center; gap: 16rpx; z-index: 5; }
.icon-btn { position: relative; width: 76rpx; height: 76rpx; border-radius: 50%; background: rgba(30, 31, 26, 0.72); color: var(--ink);
  border: 2rpx solid rgba(255, 253, 243, 0.14); display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.icon-btn.on { background: var(--gold-bg); color: var(--gold); border-color: rgba(230, 213, 173, 0.5); }
.presence-chip { background: rgba(30, 31, 26, 0.72); border: 2rpx solid rgba(255, 253, 243, 0.14); border-radius: 999rpx; padding: 0 26rpx; height: 68rpx;
  font-size: 25rpx; color: var(--ink); display: flex; align-items: center; white-space: nowrap; }
.live { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--stone-light); margin-left: 12rpx; }
.live.on { background: var(--ok); box-shadow: 0 0 10rpx var(--ok); }

.tomb-title { position: fixed; left: 24rpx; z-index: 5; display: flex; flex-direction: column; gap: 8rpx; align-items: flex-start; }
.season-chip, .name-chip { font-size: 23rpx; background: rgba(30, 31, 26, 0.6); border-radius: 999rpx; padding: 6rpx 20rpx; color: var(--ink-soft); }
.name-chip.strong { font-family: var(--serif); font-size: 32rpx; color: var(--gold); font-weight: 700; padding: 8rpx 24rpx; background: rgba(30, 31, 26, 0.72); }

.icon-col { position: fixed; right: 20rpx; z-index: 5; display: flex; flex-direction: column; gap: 16rpx; }
.dot-badge { position: absolute; right: -6rpx; top: -6rpx; min-width: 32rpx; height: 32rpx; border-radius: 16rpx; background: #b4463c; color: #fff;
  font-size: 20rpx; display: flex; align-items: center; justify-content: center; padding: 0 6rpx; }

.action-toast { position: fixed; left: 50%; transform: translateX(-50%); z-index: 25; background: rgba(20, 21, 17, 0.82); color: var(--ink);
  font-size: 26rpx; padding: 16rpx 32rpx; border-radius: 999rpx; white-space: nowrap; pointer-events: none; opacity: 0; transition: opacity 0.3s;
  border: 2rpx solid rgba(255, 253, 243, 0.12); }
.action-toast.show { opacity: 1; }
.gesture-tip { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(176rpx + env(safe-area-inset-bottom)); z-index: 4;
  font-size: 23rpx; color: var(--ink-soft); background: rgba(20, 21, 17, 0.6); padding: 10rpx 26rpx; border-radius: 999rpx; white-space: nowrap;
  pointer-events: none; opacity: 0; transition: opacity 0.6s; }
.gesture-tip.show { opacity: 1; }

.side-actions { position: fixed; right: 20rpx; bottom: calc(176rpx + env(safe-area-inset-bottom)); z-index: 5; display: flex; flex-direction: column; gap: 16rpx; }
.side-btn { width: 116rpx; min-height: 108rpx; border-radius: 22rpx; background: rgba(30, 31, 26, 0.72); color: var(--ink); border: 2rpx solid rgba(255, 253, 243, 0.14);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; font-size: 22rpx; }

.wipe-panel { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(176rpx + env(safe-area-inset-bottom)); width: 460rpx; z-index: 6;
  background: rgba(30, 31, 26, 0.86); border: 2rpx solid rgba(255, 253, 243, 0.14); border-radius: 22rpx; padding: 20rpx 24rpx; font-size: 24rpx; color: var(--ink-soft);
  opacity: 0; transition: opacity 0.3s; pointer-events: none; }
.wipe-panel.show { opacity: 1; }
.wipe-panel .row { display: flex; justify-content: space-between; align-items: center; }
.wipe-panel .strong { color: var(--ink); font-size: 28rpx; font-weight: 600; }
.wipe-panel .tip { margin-top: 8rpx; font-size: 22rpx; color: var(--stone); }
.wipe-bar { height: 10rpx; border-radius: 10rpx; background: rgba(255, 253, 243, 0.14); margin-top: 12rpx; overflow: hidden; }
.wipe-bar .fill { height: 100%; background: var(--gold); transition: width 0.2s; }

.ritual-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 5; display: flex; justify-content: space-around;
  padding: 18rpx 12rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(27, 28, 23, 0), rgba(27, 28, 23, 0.6) 22%, rgba(27, 28, 23, 0.94)); }
.ritual-btn { flex: 1; min-height: 112rpx; color: var(--ink); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; font-size: 22rpx; letter-spacing: 0.04em; }
.ritual-btn .ri { width: 48rpx; height: 48rpx; }
.ritual-btn.active { color: var(--gold); }
.ritual-btn:active .ri { transform: scale(0.92); }

.loading { position: fixed; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28rpx;
  background: #24251f; z-index: 12; font-family: var(--serif); color: var(--ink-soft); }
.ldot { width: 18rpx; height: 18rpx; border-radius: 50%; background: var(--gold); animation: pulse 1.2s ease infinite; }
@keyframes pulse { 0%, 100% { opacity: 0.3; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1); } }
.overlay-center { position: fixed; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; background: #24251f; z-index: 20; padding: 40rpx; }
.err-card { width: 100%; }

.mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(10, 10, 8, 0.4); z-index: 9; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; background: rgba(30, 31, 26, 0.97); border-top: 2rpx solid var(--line); border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); max-height: 76vh; box-sizing: border-box;
  transform: translateY(105%); transition: transform 0.26s ease; }
.sheet.open { transform: translateY(0); }
.close-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.h3 { font-family: var(--serif); font-size: 34rpx; font-weight: 700; color: var(--ink); }
.close { color: var(--gold); font-size: 28rpx; padding: 8rpx 0 8rpx 24rpx; }
.sub { color: var(--ink-soft); font-size: 26rpx; line-height: 1.6; margin-bottom: 24rpx; }
.center { text-align: center; }
.pad { padding: 40rpx 0; }
.opt-title { font-size: 25rpx; color: var(--stone); margin: 24rpx 0 12rpx; }
.flower-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20rpx; margin-bottom: 28rpx; }
.flower-opt { border: 2rpx solid var(--line); border-radius: 20rpx; background: var(--field); min-height: 176rpx; color: var(--ink);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; font-size: 28rpx; }
.flower-opt:active { border-color: rgba(230, 213, 173, 0.6); background: var(--gold-bg); }
.f-dot { width: 88rpx; height: 88rpx; border-radius: 50%; }
.f-baiju { background: radial-gradient(circle, #e8cf6a 18%, #f7f4ea 22%, #f7f4ea 60%, #dcd6c4 100%); }
.f-huangju { background: radial-gradient(circle, #b9822a 18%, #f2c94c 22%, #f2c94c 60%, #d9a92e 100%); }
.f-cuibai { background: radial-gradient(circle, #6f9a63 20%, #4f7d4f 60%, #3a6440 100%); }
.msg-list { max-height: 34vh; margin-bottom: 20rpx; }
.msg { padding: 20rpx 0; border-bottom: 2rpx solid var(--line); }
.meta { font-size: 23rpx; color: var(--stone); margin-bottom: 4rpx; }
.body { font-size: 28rpx; line-height: 1.6; word-break: break-all; color: var(--ink); }
.badge { display: inline-block; font-size: 21rpx; padding: 2rpx 12rpx; border-radius: 10rpx; background: rgba(255,253,243,0.1); color: var(--ink-soft); margin-left: 12rpx; }
.badge.wait { background: var(--gold-bg); color: var(--gold); }
.badge.off { background: rgba(229, 156, 136, 0.16); color: var(--danger); }
.mod { margin-top: 12rpx; display: flex; gap: 16rpx; }
.mbtn { font-size: 24rpx; padding: 8rpx 24rpx; border-radius: 14rpx; border: 2rpx solid var(--line); background: var(--field); color: var(--ink); }
.mbtn.ok { background: var(--pine); border-color: var(--pine); color: var(--paper); }
.compose { margin-bottom: 20rpx; width: auto; }
.name-row { display: flex; gap: 16rpx; align-items: center; }
.grow { flex: 1; }
.btn.share { margin-bottom: 20rpx; }

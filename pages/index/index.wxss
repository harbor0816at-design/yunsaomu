.wrap { display: flex; flex-direction: column; align-items: center; padding: 72rpx 44rpx calc(64rpx + env(safe-area-inset-bottom)); }
.brand { display: flex; flex-direction: column; align-items: center; text-align: center; margin: 40rpx 0 56rpx; }
.mark { width: 128rpx; height: 128rpx; margin-bottom: 20rpx; }
.h1 { font-family: var(--serif); font-weight: 700; font-size: 64rpx; letter-spacing: 0.18em; color: var(--ink); }
.slogan { font-family: var(--serif); font-size: 38rpx; letter-spacing: 0.12em; color: var(--ink); margin-top: 16rpx; }
.desc { max-width: 28em; line-height: 1.7; color: var(--ink-soft); font-size: 30rpx; margin-top: 20rpx; }
.minor-tip { font-size: 24rpx; color: var(--stone); margin-top: 16rpx; }
.actions { display: flex; flex-direction: column; gap: 24rpx; width: 100%; }
.panel { width: 100%; margin-top: 32rpx; }
.h3 { font-family: var(--serif); font-size: 34rpx; font-weight: 700; margin-bottom: 16rpx; }
.sub { color: var(--ink-soft); font-size: 26rpx; line-height: 1.6; margin-bottom: 20rpx; }
.row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid #e0d9c8; }
.row-main { flex: 1; }
.row-name { font-size: 32rpx; font-family: var(--serif); }
.row-sub { font-size: 24rpx; color: var(--stone); }
.row-go { color: var(--stone); font-size: 44rpx; }
.tip { margin-top: 16rpx; }
.link { color: var(--pine); margin-top: 12rpx; text-decoration: underline; }
.join-btns { display: flex; gap: 20rpx; margin-top: 24rpx; }
.join-btns .btn { flex: 1; }
.footer { margin-top: 56rpx; padding: 16rpx; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12rpx 20rpx; font-size: 24rpx; color: var(--stone); }
.footer .a { color: var(--pine); text-decoration: underline; }
.footer .pending { background: #efe3c0; color: #6a4a12; font-weight: 600; padding: 2rpx 14rpx; border-radius: 12rpx; }

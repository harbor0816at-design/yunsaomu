.wrap { position: relative; display: flex; flex-direction: column; align-items: center; padding: 0 40rpx calc(64rpx + env(safe-area-inset-bottom)); }
.hero { position: relative; width: 100vw; height: 760rpx; margin: 0 -40rpx; overflow: hidden; }
.hero image { width: 100%; height: 100%; }
.hero .fade { position: absolute; left: 0; right: 0; bottom: 0; height: 360rpx; background: linear-gradient(180deg, rgba(36,37,31,0), #24251f); }
.brand { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; margin: -200rpx 0 48rpx; }
.mark { width: 128rpx; height: 128rpx; margin-bottom: 20rpx; }
.h1 { font-family: var(--serif); font-weight: 700; font-size: 64rpx; letter-spacing: 0.18em; color: var(--ink); text-shadow: 0 4rpx 24rpx rgba(0,0,0,0.5); }
.slogan { font-family: var(--serif); font-size: 36rpx; letter-spacing: 0.12em; color: var(--gold); margin-top: 16rpx; }
.desc { max-width: 28em; line-height: 1.7; color: var(--ink-soft); font-size: 30rpx; margin-top: 20rpx; }
.minor-tip { font-size: 24rpx; color: var(--stone); margin-top: 16rpx; }
.actions { display: flex; flex-direction: column; gap: 24rpx; width: 100%; }
.panel { width: 100%; margin-top: 32rpx; }
.h3 { font-family: var(--serif); font-size: 34rpx; font-weight: 700; margin-bottom: 16rpx; }
.sub { color: var(--ink-soft); font-size: 26rpx; line-height: 1.6; margin-bottom: 20rpx; }
.row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid var(--line); }
.row-main { flex: 1; }
.row-name { font-size: 32rpx; font-family: var(--serif); }
.row-sub { font-size: 24rpx; color: var(--stone); }
.row-go { color: var(--stone); font-size: 44rpx; }
.tip { margin-top: 16rpx; }
.link { color: var(--gold); margin-top: 12rpx; }
.join-btns { display: flex; gap: 20rpx; margin-top: 24rpx; }
.join-btns .btn { flex: 1; }
.footer { margin-top: 56rpx; padding: 16rpx; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12rpx 20rpx; font-size: 24rpx; color: var(--stone); }
.footer .a { color: var(--ink-soft); text-decoration: underline; }
.footer .pending { background: var(--gold-bg); color: var(--gold); padding: 2rpx 14rpx; border-radius: 10rpx; }

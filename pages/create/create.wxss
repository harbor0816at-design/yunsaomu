.wrap { padding: 40rpx 40rpx calc(60rpx + env(safe-area-inset-bottom)); min-height: 100vh; box-sizing: border-box; }
.consent { display: flex; gap: 20rpx; padding: 28rpx; border: 1rpx solid var(--line); border-radius: 20rpx; margin-bottom: 44rpx; background: rgba(255,255,255,0.03); }
.box { flex: none; width: 40rpx; height: 40rpx; border: 2rpx solid var(--accent); border-radius: 8rpx; color: var(--accent-ink);
  display: flex; align-items: center; justify-content: center; font-size: 26rpx; margin-top: 4rpx; }
.box.on { background: var(--accent); }
.consent-text { font-size: 26rpx; color: var(--dim); line-height: 1.7; }
.a { color: var(--accent); }
.hint { margin: 8rpx 0 40rpx; }
.who { font-size: 34rpx; margin-bottom: 36rpx; color: var(--accent); }
.date-row { display: flex; align-items: center; gap: 20rpx; margin-top: 16rpx; }
.date-row picker { flex: 1; }
.picker { display: flex; align-items: center; color: var(--ink); }
.clear { color: var(--dim); font-size: 26rpx; }
.more { color: var(--dim); font-size: 28rpx; margin: 8rpx 0 32rpx; }
.small { font-size: 22rpx; margin-top: 8rpx; }
.switch-row { display: flex; justify-content: space-between; align-items: center; }
.nomb { margin-bottom: 0 !important; }
.err.big { margin-bottom: 24rpx; font-size: 28rpx; }
.actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.actions .btn { flex: 1; }
.actions .grow { flex: 2; }
.mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 50; }
.dialog { width: 620rpx; background: var(--panel); border: 1rpx solid var(--line); border-radius: 28rpx; padding: 44rpx 40rpx; display: flex; flex-direction: column; gap: 24rpx; }
.d-title { font-size: 38rpx; text-align: center; color: var(--accent); }
.d-body { font-size: 28rpx; line-height: 1.7; }
.warn { color: #f0a58a; }

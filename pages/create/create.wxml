<view class="page-bg wrap">
  <view class="card">
    <view class="steps"><text class="on"></text><text class="{{step === 2 ? 'on' : ''}}"></text></view>
    <view class="h2">为亲人建一座纪念墓</view>

    <!-- 第一屏：称呼 + 同意 -->
    <view wx:if="{{step === 1}}">
      <view class="sub">只需填写称呼就能建好。其余资料都可以留空，墓园场景使用默认设置。</view>
      <view class="field">
        <view class="label">称呼 / 姓名（必填，不超过 40 字）</view>
        <input class="input" value="{{name}}" maxlength="40" placeholder="例如：奶奶、王秀兰" bindinput="onName" />
      </view>
      <view class="consent" bindtap="toggleConsent">
        <view class="box {{consent ? 'on' : ''}}">{{consent ? '✓' : ''}}</view>
        <view>我确认有权发布这些资料（一般为近亲属），了解这座墓仅持有链接的人可见，留言需审核后才公开。已阅读<text class="a" catchtap="goLegal" data-doc="privacy">隐私政策</text>和<text class="a" catchtap="goLegal" data-doc="terms">用户协议</text>。</view>
      </view>
      <view wx:if="{{nameErr}}" class="err">{{nameErr}}</view>
      <button class="btn" hover-class="hover" bindtap="next">下一步</button>
    </view>

    <!-- 第二屏：选填项，园景已预选，可直接建立 -->
    <view wx:if="{{step === 2}}">
      <view class="sub">为「{{name}}」补充资料。都可以留空，直接点「建立」。</view>

      <view class="opt-title">墓园场景</view>
      <view class="seg">
        <view wx:for="{{scenes}}" wx:key="id" class="seg-btn {{sceneTheme === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="setScene">{{item.name}}</view>
      </view>

      <view class="opt-title">生年或生日（可留空）</view>
      <view class="seg">
        <view wx:for="{{precisions}}" wx:key="id" class="seg-btn {{birthPrec === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="setBirthPrec">{{item.name}}</view>
      </view>
      <view class="date-row">
        <picker mode="date" fields="{{birthPrec}}" start="1800-01-01" end="{{today}}" value="{{birth}}" bindchange="onBirth">
          <view class="input picker {{birth ? '' : 'ph'}}">{{birth || '选择日期'}}</view>
        </picker>
        <text wx:if="{{birth}}" class="clear" bindtap="clearBirth">清除</text>
      </view>

      <view class="opt-title">卒年或忌日（可留空）</view>
      <view class="seg">
        <view wx:for="{{precisions}}" wx:key="id" class="seg-btn {{deathPrec === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="setDeathPrec">{{item.name}}</view>
      </view>
      <view class="date-row">
        <picker mode="date" fields="{{deathPrec}}" start="1800-01-01" end="{{today}}" value="{{death}}" bindchange="onDeath">
          <view class="input picker {{death ? '' : 'ph'}}">{{death || '选择日期'}}</view>
        </picker>
        <text wx:if="{{death}}" class="clear" bindtap="clearDeath">清除</text>
      </view>

      <view class="opt-title">墓志铭（选填，不超过 80 字）</view>
      <textarea class="textarea" value="{{epitaph}}" maxlength="80" placeholder="想刻在碑上的一句话" bindinput="onEpitaph" auto-height />

      <view class="more-toggle" bindtap="toggleMore">{{showMore ? '收起更多设置' : '更多设置：墓地地址、墓碑样式、分享卡片'}}</view>
      <view wx:if="{{showMore}}" class="more-box">
        <view class="field">
          <view class="label">真实墓地地址（选填，仅你自己可见）</view>
          <input class="input" value="{{address}}" maxlength="120" placeholder="例如：某市某陵园 A 区 1 排" bindinput="onAddress" />
          <view class="hint">地址只在管理入口中显示，不会出现在访客页面、分享卡片或链接预览里。</view>
        </view>
        <view class="opt-title">墓碑样式</view>
        <view class="styles">
          <view wx:for="{{styles}}" wx:key="id" class="style-opt {{stele === item.id ? 'picked' : ''}}" data-id="{{item.id}}" bindtap="setStele">
            <view class="style-name">{{item.name}}</view>
            <view class="style-desc">{{item.desc}}</view>
          </view>
        </view>
        <view class="consent share" bindtap="toggleShareName">
          <view class="box {{showNameInShare ? 'on' : ''}}">{{showNameInShare ? '✓' : ''}}</view>
          <view>分享卡片标题中显示称呼（封面始终用通用墓园图，不用照片、不含地址）。</view>
        </view>
      </view>

      <view wx:if="{{err}}" class="err">{{err}}</view>
      <view class="actions">
        <button class="btn ghost" hover-class="hover" bindtap="back">上一步</button>
        <button class="btn grow" hover-class="hover" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">建立</button>
      </view>
    </view>
  </view>

  <!-- 建立成功：管理权限说明（账号上线前它是唯一凭证） -->
  <view wx:if="{{created}}" class="overlay">
    <view class="card done">
      <view class="h2">纪念墓已建好</view>
      <view class="sub">管理权限已保存在这台手机上。请再把管理链接私下保存一份（密码本或文件），<text class="warn">不要发到家族群以外</text>。邀请家人请在墓前点「邀」转发。</view>
      <button class="btn ghost" hover-class="hover" bindtap="copyAdmin">复制管理链接</button>
      <button class="btn" hover-class="hover" bindtap="enterTomb">进入纪念墓</button>
    </view>
  </view>
</view>
